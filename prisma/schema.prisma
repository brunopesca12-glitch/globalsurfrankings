generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ATHLETE
  ADMIN
}

enum VerificationTier {
  VERIFIED
  VERIFIED_PRO
}

enum Sex {
  M
  W
}

enum CategoryCode {
  OPEN
  JUNIOR
  MASTERS_40
  MASTERS_50
}

enum Environment {
  OCEAN
  POOL
}

enum EntryStatus {
  SUBMITTED
  PLACED
}

/// CLEAR has passed the automatic checks, or the desk has accepted it.
/// PENDING_REVIEW is in the contest and waiting for a person.
enum ReviewStatus {
  CLEAR
  PENDING_REVIEW
}

/// UNFIT waves are refused and are not stored.
enum ModalityCheck {
  FIT
  UNCERTAIN
  UNAVAILABLE
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             UserRole  @default(ATHLETE)
  createdAt        DateTime  @default(now())
  /// Desk override. When set, it replaces the automatic college.
  collegeOverride  College?
  /// Set when the judge finishes or skips the first-visit explanation.
  judgeOnboardedAt DateTime?
  /// Opt in to appear by name on the college judge list.
  judgeNamePublic  Boolean   @default(false)
  /// When this account accepted the Terms of Use.
  termsAcceptedAt  DateTime?
  /// Version of the terms they accepted. See lib/legal.ts.
  termsVersion     String?
  /// Set when the desk closes the account for a reposted or already published wave.
  bannedAt         DateTime?
  banReason        String    @default("")
  /// May lock calibration keys with the desk.
  calibrationPro   Boolean   @default(false)
  athlete          Athlete?
  seats            CollegeSeat[]
  ballots          Ballot[]
  publicationFlags PublicationFlag[]
  passwordResets   PasswordResetToken[]
  follows          Follow[]
  shakas           Shaka[]
  calibrationVotes CalibrationVote[]
  eyeDays          EyeDay[]
  voteCommits      VoteCommit[]
}

model Athlete {
  id                 String           @id @default(cuid())
  userId             String           @unique
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName        String
  slug               String           @unique
  verification       VerificationTier @default(VERIFIED)
  sex                Sex
  birthDate          DateTime         @db.Date
  country            String           @default("BR")
  city               String?
  club               String?
  hashtags           String[]
  bio                String?
  /// Public USDC address. Never a key or a seed phrase.
  walletNetwork      String?
  walletAddress      String?
  /// Legacy desk flag. Eligibility is the weekly ballot queue. The column stays so existing rows are not rewritten.
  judgingDutyCurrent Boolean          @default(true)
  createdAt          DateTime         @default(now())
  entries            Entry[]
  placements         Placement[]
  followers          Follow[]
}

model Season {
  id       String   @id @default(cuid())
  vintage  Int      @unique
  name     String
  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date
  ageAsOf  DateTime @db.Date
  /// Preseason points stay off the Founding Season tables.
  countsForRanking Boolean @default(true)
  themes   Theme[]
  entries  Entry[]
}

model Theme {
  id         String   @id @default(cuid())
  seasonId   String
  season     Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  slug       String
  name       String
  namePt     String
  finaleOn   DateTime @db.Date
  sortOrder  Int
  open       Boolean
  junior     Boolean
  masters40  Boolean
  masters50  Boolean
  oceanOnly  Boolean
  poolOnly   Boolean
  proposed   Boolean  @default(false)
  note       String   @default("")
  boards     Board[]
  entries    Entry[]

  @@unique([seasonId, slug])
}

model Entry {
  id          String       @id @default(cuid())
  athleteId   String
  athlete     Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  themeId     String
  theme       Theme        @relation(fields: [themeId], references: [id])
  seasonId    String
  season      Season       @relation(fields: [seasonId], references: [id])
  environment Environment
  videoUrl    String
  spot        String?
  isoYear     Int
  isoWeek     Int
  tollCents   Int
  status      EntryStatus  @default(SUBMITTED)
  category    CategoryCode
  sex         Sex
  /// SHA-256 of the video bytes. Null on rows entered before file checks, and on links we could not open.
  contentSha256       String?
  /// Perceptual hashes of sampled frames, full frame then a center crop. Empty when no frames were read.
  frameHashes         String[]         @default([])
  /// The athlete ticked the unpublished-wave statement.
  unpublishedAttested Boolean          @default(false)
  /// The exact statement they agreed to. Empty on older rows.
  attestationText     String           @default("")
  reviewStatus        ReviewStatus     @default(CLEAR)
  modalityCheck       ModalityCheck?
  modalityNote        String           @default("")
  /// When the athlete agreed to the Terms of Use for this upload.
  termsAcceptedAt     DateTime?
  /// Version of the terms accepted for this upload.
  termsVersion        String?
  /// Capture time read from the file, when the container had one.
  capturedAt          DateTime?
  captureDevice       String?
  captureLat          Float?
  captureLng          Float?
  /// Why the footage is in review, or empty when the file date sat inside the season.
  metadataNote        String           @default("")
  createdAt   DateTime     @default(now())
  placement   Placement?
  ballots     Ballot[]
  verdicts    CollegeVerdict[]
  publicationFlags PublicationFlag[]
  media       EntryMedia?
  keyframes   EntryKeyframe[]
  shakas      Shaka[]
  calibrationLeft  CalibrationDuel[] @relation("CalLeft")
  calibrationRight CalibrationDuel[] @relation("CalRight")
  /// Why Monday left this wave unranked. NONE once it has a place, or before the first drop.
  holdReason       HoldReason      @default(NONE)
  /// Mondays on which this wave missed the judge quorum.
  rolloverCount    Int             @default(0)
  lastHoldYear     Int?
  lastHoldWeek     Int?
  voteCommits      VoteCommit[]

  @@index([athleteId, isoYear, isoWeek, environment])
  @@index([themeId, category, sex])
  @@index([reviewStatus])
  @@unique([contentSha256])
}

/// Bytes for a file uploaded on a host with no blob store. The public URL stays on Entry.videoUrl.
model EntryMedia {
  entryId  String @id
  entry    Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  mimeType String
  bytes    Bytes
}

/// A signed-in surfer or judge reports that this wave was already published.
model PublicationFlag {
  id         String    @id @default(cuid())
  entryId    String
  entry      Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  note       String    @default("")
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@unique([entryId, userId])
  @@index([resolvedAt])
}

model Board {
  id         String       @id @default(cuid())
  themeId    String
  theme      Theme        @relation(fields: [themeId], references: [id], onDelete: Cascade)
  category   CategoryCode
  sex        Sex
  placements Placement[]

  @@unique([themeId, category, sex])
}

model Placement {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  entryId   String   @unique
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  place     Int
  createdAt DateTime @default(now())

  @@unique([boardId, place])
  @@index([athleteId])
}

enum College {
  CHAMBER
  RANKED
  ATHLETES
  UPPER
  PUBLIC
}

enum BallotStatus {
  OPEN
  SEALED
}

enum ComparisonResult {
  BETTER
  WORSE
}

/** Desk seats for College 1 and College 2. The other colleges are resolved, not stored. */
model CollegeSeat {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College
  createdAt DateTime @default(now())

  @@unique([userId, college])
}

/** One drawn wave. The place stays on this row and is never selected for a public page. */
model Ballot {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryId       String
  entry         Entry              @relation(fields: [entryId], references: [id], onDelete: Cascade)
  college       College
  isoYear       Int
  isoWeek       Int
  status        BallotStatus       @default(OPEN)
  boardEntryIds String[]
  lo            Int                @default(0)
  hi            Int
  place         Int?
  sealedAt      DateTime?
  createdAt     DateTime           @default(now())
  comparisons   BallotComparison[]

  @@unique([userId, entryId])
  @@index([entryId, college])
  @@index([userId, isoYear, isoWeek])
}

model BallotComparison {
  id           String           @id @default(cuid())
  ballotId     String
  ballot       Ballot           @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  probeIndex   Int
  probeEntryId String
  result       ComparisonResult
  /// Bounds before this comparison, so it can be undone while the ballot is open.
  loBefore     Int              @default(0)
  hiBefore     Int              @default(0)
  /// False on rows written before undo existed. Those cannot be rewound.
  anchored     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  commit       VoteCommit?

  @@index([ballotId])
}

/** Personal link that seats an invited judge, usually a legend, in one college. */
model JudgeInvite {
  id           String    @id @default(cuid())
  token        String    @unique
  college      College
  email        String?
  note         String    @default("")
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  acceptedAt   DateTime?
  acceptedById String?

  @@index([email])
}

/** Single-use password reset. The raw token is emailed; only its hash is stored. */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model VerdictRun {
  id        String           @id @default(cuid())
  isoYear   Int
  isoWeek   Int
  placed    Int
  held      Int
  createdAt DateTime         @default(now())
  verdicts  CollegeVerdict[]
}

/** The public college line. Individual ballots are not on this table. */
model CollegeVerdict {
  id        String     @id @default(cuid())
  entryId   String
  entry     Entry      @relation(fields: [entryId], references: [id], onDelete: Cascade)
  college   College
  place     Int?
  ballots   Int
  runId     String
  run       VerdictRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([entryId, college])
}

/// A surfer follows an athlete. Friends' unjudged weeks show as locked cards.
model Follow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation(fields: [followerId], references: [id], onDelete: Cascade)
  athleteId  String
  athlete    Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, athleteId])
  @@index([athleteId])
}

/// The only reaction on The Lineup.
model Shaka {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryId   String
  entry     Entry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, entryId])
  @@index([entryId])
}

/// JPEG keyframes kept so the desk can compare a wave by eye.
model EntryKeyframe {
  id       String @id @default(cuid())
  entryId  String
  entry    Entry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position Int
  bytes    Bytes

  @@unique([entryId, position])
}

enum HigherSide {
  LEFT
  RIGHT
}

enum HoldReason {
  NONE
  QUORUM
}

enum VoteConfidence {
  CONFIDENT
  UNSURE
}

/// A pairwise duel with a known answer once the pros agree.
model CalibrationDuel {
  id           String             @id @default(cuid())
  leftEntryId  String
  rightEntryId String
  leftEntry    Entry              @relation("CalLeft", fields: [leftEntryId], references: [id], onDelete: Cascade)
  rightEntry   Entry              @relation("CalRight", fields: [rightEntryId], references: [id], onDelete: Cascade)
  /// Which clip goes higher. Null until the key locks.
  higher       HigherSide?
  createdAt    DateTime           @default(now())
  votes        CalibrationVote[]
  answers      CalibrationAnswer[]

  @@unique([leftEntryId, rightEntryId])
}

model CalibrationVote {
  id        String          @id @default(cuid())
  duelId    String
  duel      CalibrationDuel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  higher    HigherSide
  createdAt DateTime        @default(now())

  @@unique([duelId, userId])
}

model CalibrationAnswer {
  id        String          @id @default(cuid())
  duelId    String
  duel      CalibrationDuel @relation(fields: [duelId], references: [id], onDelete: Cascade)
  userId    String?
  guestKey  String?
  higher    HigherSide
  correct   Boolean
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([guestKey])
}

/// One row per judge per São Paulo day. Streaks are counted from these days.
model EyeDay {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day              DateTime @db.Date
  duels            Int      @default(0)
  calibrations     Int      @default(0)
  calibrationHits  Int      @default(0)

  @@unique([userId, day])
}

/// SHA-256 commitment of one pairwise vote. The preimage is revealed on the receipt.
model VoteCommit {
  id            String           @id @default(cuid())
  comparisonId  String           @unique
  comparison    BallotComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  entryId       String
  entry         Entry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  probeEntryId  String
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Stable public code. Not a name.
  pseudonym     String
  choice        ComparisonResult
  nonce         String
  committedAt   DateTime
  payloadHash   String
  confidence    VoteConfidence?
  eyeScore      Int
  eyeLevel      String
  /// Eligible for this wave's title, and not judging their own division.
  qualified     Boolean
  /// Answered the calibration minimum before this vote.
  calibrated    Boolean
  themeSlug     String
  isoYear       Int
  isoWeek       Int

  @@index([entryId])
  @@index([isoYear, isoWeek])
  @@index([userId])
}

/// Weekly Merkle root of vote hashes. `chainTx` is reserved for a later on-chain anchor.
model WeekRoot {
  id          String   @id @default(cuid())
  isoYear     Int
  isoWeek     Int
  merkleRoot  String
  voteCount   Int
  publishedAt DateTime @default(now())
  chainTx     String?

  @@unique([isoYear, isoWeek])
}
