DATABASE_URL="postgresql://gsr:gsr@localhost:5432/gsr?schema=public"
AUTH_SECRET="dev-only-gsr-secret-change-me"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Password reset mail. Sender is GSR <no-reply@gsr.surf>. If this is unset, the forgot-password
# page says so and does not crash. In Resend, add the domain gsr.surf and publish the records
# Resend shows: DKIM (usually a TXT or CNAME on resend._domainkey), SPF (TXT on send:
# v=spf1 include:amazonses.com ~all, plus the MX Resend lists for send), and DMARC
# (TXT on _dmarc: v=DMARC1; p=none;). Do not invent the DKIM value; copy it from Resend.
# RESEND_API_KEY=
# Pool verification toll in cents. Unset, 0, or off means entry is free. Set 2000 to record a US$ 20 toll later.
# GSR_POOL_FEE_CENTS=0
# Prize-money figures stay blank unless this is on. On does not invent a purse; it allows published orders.
# GSR_PRIZE_MONEY=off
# Preview builds must not use the production database. On the Vercel Preview environment set
# DATABASE_URL to a separate Neon branch, and set PREVIEW_DATABASE_URL to that same URL so
# prisma migrate deploy runs there instead of production.
# PREVIEW_DATABASE_URL=
# Visitor gate. Leave SITE_GATE_PASSWORD unset to keep the site open.
# SITE_GATE_USER="gsr"
# SITE_GATE_PASSWORD=
# Automatic title check. Set one key. Without any of them, a wave is accepted and marked pending review.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini
# GEMINI_VISION_MODEL=gemini-2.5-flash
# ANTHROPIC_VISION_MODEL=claude-haiku-4-5
# Used when no direct key above is set. On Vercel, VERCEL_OIDC_TOKEN is provided and the gateway signs in with it.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=google/gemini-2.5-flash
# Large file uploads on Vercel. Without it, paste a direct video link or send a smaller file.
# BLOB_READ_WRITE_TOKEN=
# Optional path to ffmpeg. Defaults to the bundled binary, then ffmpeg on PATH.
# FFMPEG_PATH=
